{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vscode"],
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "paths": {
      "monaco-editor/*": ["./node_modules/monaco-editor/esm/vs/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
